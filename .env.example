# Backendless REST base URL (Console > Manage > App Settings).
# Preferred: subdomain form, e.g. https://your-subdomain.backendless.app/api (no keys in the URL).
# Alternative: https://api.backendless.com/<APP_ID>/<REST_API_KEY>
VITE_BACKENDLESS_API_URL=

# Only needed if you use the api.backendless.com form above. The REST key is a public client key;
# security comes from table permissions, never put a CloudCode/server key here.
VITE_BACKENDLESS_APP_ID=
VITE_BACKENDLESS_REST_KEY=

# Public site URL used for canonical/OG tags (production Vercel alias).
VITE_SITE_URL=https://your-company-profile.vercel.app
